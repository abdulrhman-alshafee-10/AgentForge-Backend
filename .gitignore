# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Build output ────────────────────────────────────────────────────────────
dist/

# ─── Environment files ───────────────────────────────────────────────────────
# Never commit real env files. Commit .env.example only.
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pino.log

# ─── TypeScript cache ────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor / IDE ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Test coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Prisma (added in Phase 02) ──────────────────────────────────────────────
# Keep migrations and schema tracked; ignore generated client
prisma/generated/

# ─── Uploads / temporary files ───────────────────────────────────────────────
uploads/
tmp/
temp/
