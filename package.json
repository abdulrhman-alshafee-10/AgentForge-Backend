{
  "name": "agentforge-backend",
  "version": "0.1.0",
  "description": "AgentForge backend — Agentic AI platform",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "tsx watch src/worker.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.19.2",
    "helmet": "7.1.0",
    "pino": "9.4.0",
    "pino-http": "10.3.0",
    "uuid": "10.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.16.1",
    "@types/uuid": "10.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  }
}
