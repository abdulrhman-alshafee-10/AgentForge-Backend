# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ─── Body size limit ───────────────────────────────────────────────────────────
BODY_LIMIT=1mb

# ─── Shutdown ──────────────────────────────────────────────────────────────────
# How long (ms) to wait for in-flight requests before forcing exit
SHUTDOWN_TIMEOUT_MS=10000

# ─── Database (added in Phase 02) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/agentforge

# ─── Redis (Phase 05) + BullMQ job queue (Phase 09) ────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RAG / LLM (Phase 06-07) ───────────────────────────────────────────────────
# Base URL of your Ollama instance (OpenAI-compatible /v1 endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
# Ollama ignores the API key but the OpenAI SDK requires a non-empty value
OLLAMA_API_KEY=ollama
# Embedding model name (pull first: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text
# Chat model used by summarize / generate_report tools (pull first: ollama pull llama3.2)
OLLAMA_CHAT_MODEL=llama3.2
STORAGE_PATH=./storage/documents

# ─── JWT (added in Phase 03) ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-minimum-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Rate limiting (Phase 14) ──────────────────────────────────────────────────
# General API: 120 requests per user per 60 seconds
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
# Auth endpoints: 10 attempts per IP per 60 seconds
RATE_LIMIT_AUTH_MAX=10

# ─── Caching (Phase 14) ────────────────────────────────────────────────────────
# Seconds to cache tenant settings (0 = disabled)
CACHE_TENANT_SETTINGS_TTL=30
# Seconds to cache embeddings by content hash (0 = disabled)
CACHE_EMBEDDING_TTL=3600
