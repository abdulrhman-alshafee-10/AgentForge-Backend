# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ─── Body size limit ───────────────────────────────────────────────────────────
BODY_LIMIT=1mb

# ─── Shutdown ──────────────────────────────────────────────────────────────────
# How long (ms) to wait for in-flight requests before forcing exit
SHUTDOWN_TIMEOUT_MS=10000

# ─── Database (added in Phase 02) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/agentforge

# ─── Redis (added in Phase 05) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RAG (added in Phase 06) ───────────────────────────────────────────────────
OLLAMA_API_KEY=your-ollama-api-key-here
STORAGE_PATH=./storage/documents

# ─── JWT (added in Phase 03) ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-minimum-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
